@PACKAGE_INIT@

set(mmxisf_LINKAGE "@MMXISF_BINARY_LINKAGE@")
if(mmxisf_LINKAGE STREQUAL "static")
  include(CMakeFindDependencyMacro)
  find_dependency(EXPAT 2.2)
  list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
  find_dependency(LZ4)
  find_dependency(ZSTD)
  list(POP_BACK CMAKE_MODULE_PATH)
  find_dependency(OpenSSL 3.0 COMPONENTS Crypto)
  find_dependency(ZLIB)
elseif(NOT mmxisf_LINKAGE STREQUAL "shared")
  message(FATAL_ERROR "Installed mmxisf package has invalid linkage metadata")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/mmxisfTargets.cmake")
set_and_check(
  mmxisf_BINARY_SBOM
  "@PACKAGE_MMXISF_INSTALL_SBOM_DIR@/binary-dependencies.spdx.json"
)
set_and_check(
  mmxisf_EXAMPLES_DIR
  "@PACKAGE_MMXISF_INSTALL_EXAMPLES_DIR@"
)
set_and_check(
  mmxisf_SUPPORT_PROFILE
  "@PACKAGE_MMXISF_INSTALL_CONFORMANCE_DIR@/support-profile-0.1.0.json"
)
set_and_check(
  mmxisf_PUBLIC_API_BASELINE
  "@PACKAGE_MMXISF_INSTALL_CONFORMANCE_DIR@/public-api-baseline-0.1.0.json"
)
set_and_check(
  mmxisf_CONFORMANCE_MATRIX
  "@PACKAGE_MMXISF_INSTALL_CONFORMANCE_DIR@/xisf-1.0-matrix.json"
)
set_and_check(
  mmxisf_SPECIFICATION_BASELINE
  "@PACKAGE_MMXISF_INSTALL_CONFORMANCE_DIR@/specification-baseline.json"
)
check_required_components(mmxisf)
