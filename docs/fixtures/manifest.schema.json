{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mmxisf:schema:fixture-manifest:1.0.0",
  "title": "mmxisf fixture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "fixtures"],
  "properties": {
    "schema": {"const": "mmxisf.fixture-manifest/1.0.0"},
    "fixtures": {
      "type": "array",
      "items": {"$ref": "#/$defs/fixture"}
    }
  },
  "$defs": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "storage", "sha256", "origin", "generator",
        "generationProcedure", "redistribution", "conformanceRows",
        "expectedOutcome"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": {"enum": ["GIT_LFS", "GIT_TEXT", "LOCAL_PRIVATE"]},
            "path": {"type": "string", "minLength": 1}
          }
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "origin": {"enum": ["SYNTHETIC", "PIXINSIGHT", "THIRD_PARTY", "MUTATION"]},
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1}
          }
        },
        "generationProcedure": {"type": "string", "minLength": 1},
        "redistribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["permitted", "basis"],
          "properties": {
            "permitted": {"type": "boolean"},
            "basis": {"type": "string", "minLength": 1}
          }
        },
        "conformanceRows": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "expectedOutcome": {"enum": ["ACCEPT", "REJECT", "RESOURCE_LIMIT"]},
        "expectedArtifact": {"type": "string"},
        "notes": {"type": "string"}
      }
    }
  }
}
